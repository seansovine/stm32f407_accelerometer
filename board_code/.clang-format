# # Official Clang-Format configuration for STM32 / Embedded C projects
# Language: C
# BasedOnStyle: LLVM

# # Core Formatting Basics
ColumnLimit: 120
IndentWidth: 2
TabWidth: 2
UseTab: Never
LineEnding: LF

AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveMacros: Consecutive

AllowShortFunctionsOnASingleLine: Empty

# # Alignment Rules (Optimized for embedded readability)
# AlignAfterOpenBracket: Align
# AlignConsecutiveAssignments: None
# AlignConsecutiveDeclarations: None
# AlignConsecutiveMacros: Consecutive
# AlignEscapedNewlines: Right
# AlignOperands: Align
# AlignTrailingComments: true

# # Brace and Block Configurations
# AllowShortBlocksOnASingleLine: Never
# AllowShortCaseLabelsOnASingleLine: false
# AllowShortFunctionsOnASingleLine: None
# AllowShortIfStatementsOnASingleLine: Never
# AllowShortLoopsOnASingleLine: false

BreakBeforeBraces: Custom
BraceWrapping:
#   AfterCaseLabel: false
#   AfterClass: true
  AfterControlStatement: Always
  AfterEnum: false
  AfterFunction: true
#   AfterNamespace: false
#   AfterObjCDeclaration: false
#   AfterStruct: false
#   AfterUnion: false
#   BeforeCatch: true
  BeforeElse: true
#   BeforeLambdaBody: false
#   BeforeWhile: false
#   IndentSpaces: false
#   SplitEmptyFunction: true
#   SplitEmptyRecord: true
#   SplitEmptyNamespace: true

ReflowComments: Never

# # Embedded-Specific Layout
# AlwaysBreakAfterReturnType: None
# BinPackArguments: true
# BinPackParameters: true
# IncludeBlocks: Regroup
# IndentCaseLabels: true
# KeepEmptyLinesAtTheStartOfBlocks: false
# MaxEmptyLinesToKeep: 1
# PointerAlignment: Right
# ReflowComments: true
# SpaceAfterCStyleCast: false
# SpaceBeforeAssignmentOperators: true
# SpaceBeforeParens: ControlStatements
# SpaceInEmptyParentheses: false
# SpacesInCStyleCastParentheses: false
# SpacesInContainerLiterals: false
# SpacesInParentheses: false
# SpacesInSquareBrackets: false

# # Avoid breaking auto-generated header sort order
# SortIncludes: false